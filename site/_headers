/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pre-generated Scylla's Band samples (the voice gallery at lowkeytea.github.io/scyllasband plays them from here).
/scyllasband/samples/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

# The launch video's files never change in place (a new cut gets new names), so they're cached for a week.
/scyllasband/video/media/*
  Cache-Control: public, max-age=604800

# The demo page sets its own CSP in a <meta> tag; its worker compiles WebAssembly and fetches the model from
# Hugging Face, which the site-wide policy blocks. COOP + COEP make the page cross-origin isolated, which
# ONNX Runtime Web needs for multithreading.
/scyllasband/demo/*
  ! Content-Security-Policy
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
